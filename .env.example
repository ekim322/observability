# App identity. Set a distinct name for each service.
OTEL_SERVICE_NAME=thesis-engine
OBSERVABILITY_ENVIRONMENT=development
OBSERVABILITY_SERVICE_VERSION=unknown
OBSERVABILITY_LOG_LEVEL=INFO

# Optional OTLP/HTTP collector base URL. Leave blank for stdout-only logs.
# The library appends /v1/logs, /v1/traces, and /v1/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional comma-separated, URL-encoded key=value headers. Keep real tokens secret.
OTEL_EXPORTER_OTLP_HEADERS=

OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=5
OBSERVABILITY_METRIC_INTERVAL_SECONDS=30
